{
  "version": 2,
  "name": "vas-ai-hospital-ultimate",
  "builds": [
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/ai-gateway/(.*)",
      "dest": "/api/ai-gateway.js"
    },
    {
      "src": "/api/patients/(.*)",
      "dest": "/api/patients.js"
    },
    {
      "src": "/api/clinical/(.*)",
      "dest": "/api/clinical.js"
    },
    {
      "src": "/api/admin/(.*)",
      "dest": "/api/admin.js"
    },
    {
      "src": "/api/analytics/(.*)",
      "dest": "/api/analytics.js"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}
