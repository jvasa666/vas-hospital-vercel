{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/ai-gateway/(.*)",
      "dest": "/api/ai-gateway.js"
    },
    {
      "src": "/api/patients/(.*)",
      "dest": "/api/patients.js"
    },
    {
      "src": "/api/clinical/(.*)",
      "dest": "/api/clinical.js"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ]
}
